{
    "simulation": {
        "step_size": 0.01,
        "chrono_substeps": 10,
        "enable_realtime": true,
        "enable_logging": true,
        "start_time": 0.0,
        "end_time": 20.0
    },
    "esmini": {
        "fmu_path": "./FMU/esmini.fmu",
        "unpack_dir": "./tmp_unpack/esmini",
        "parameters": {
            "xosc_path": "./resources/esmini/xosc/acc-test.xosc",
            "use_viewer": false,
            "esmini_args": "--fixed_timestep 0.01 --window 100 100 500 500"
        }
    },
    "drivecontroller": {
        "fmu_path": "./FMU/GT-DriveController.fmu",
        "unpack_dir": "./tmp_unpack/drivecontroller",
        "parameters": {
            "PythonScriptPath": "./script/logic.py"
        }
    },
    "vehicle": {
        "fmu_path": "./FMU/FMU2cs_WheeledVehicle.fmu",
        "unpack_dir": "./tmp_unpack/vehicle",
        "parameters": {
            "data_path": "./resources/chrono/vehicle/",
            "vehicle_JSON": "./resources/chrono/vehicle/hmmwv/vehicle/HMMWV_Vehicle.json",
            "chassis_height_offset": 0.0,
            "init_height_margin": 0.5,
            "init_speed": 0.0
        }
    },
    "powertrain": {
        "fmu_path": "./FMU/FMU2cs_Powertrain.fmu",
        "unpack_dir": "./tmp_unpack/powertrain",
        "parameters": {
            "engine_JSON": "./resources/chrono/vehicle/hmmwv/powertrain/HMMWV_EngineSimpleMap.json",
            "transmission_JSON": "./resources/chrono/vehicle/hmmwv/powertrain/HMMWV_AutomaticTransmissionSimpleMap.json"
        }
    },
    "tire": {
        "fmu_path": "./FMU/FMU2cs_ForceElementTire.fmu",
        "unpack_dir_prefix": "./tmp_unpack/tire_",
        "parameters": {
            "tire_JSON": "./resources/chrono/vehicle/hmmwv/tire/HMMWV_TMeasyTire.json"
        }
    },
    "terrain": {
        "fmu_path": "./FMU/FMU2cs_Terrain.fmu",
        "unpack_dir_prefix": "./tmp_unpack/terrain_",
        "parameters": {
            "terrain_type": "Flat",
            "friction": 0.8
        }
    }
}